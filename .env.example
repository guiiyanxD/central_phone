# ==========================================
# CENTRALPHONE - PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo a '.env' y asignar los valores reales.
# NUNCA subir '.env' al control de versiones.
# ==========================================

# ------------------------------------------
# ENTORNO GENERAL
# ------------------------------------------
NODE_ENV=development
TZ=America/La_Paz

# ------------------------------------------
# BASE DE DATOS (POSTGRESQL)
# ------------------------------------------
POSTGRES_USER=centralphone_user
POSTGRES_PASSWORD=super_secure_password_example_123
POSTGRES_DB=centralphone_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cadena de conexión utilizada por Prisma y NestJS
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------
# BACKEND (NESTJS)
# ------------------------------------------
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Seguridad y Autenticación JWT
JWT_SECRET=generate_a_long_random_jwt_secret_key_minimum_64_chars_here
JWT_EXPIRES_IN=8h

# Credenciales iniciales para seeding de base de datos
ENABLE_AUTO_SEED=false
INITIAL_ADMIN_EMAIL=admin@centralphone.com
INITIAL_ADMIN_PASSWORD=change_this_admin_password_123
INITIAL_VENDEDOR_EMAIL=vendedor@centralphone.com
INITIAL_VENDEDOR_PASSWORD=change_this_vendedor_password_123

# Almacenamiento local de archivos (QRs, comprobantes, logos)
UPLOAD_LOCATION=./uploads
MAX_FILE_SIZE_MB=5

# ------------------------------------------
# FRONTEND (NEXT.JS)
# ------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=CentralPhone

# ------------------------------------------
# INTEGRACIÓN TIPO DE CAMBIO (WAVESOFT CLOUD)
# ------------------------------------------
WAVESOFT_TC_API_URL=https://wavesoft.cloud/api/v1/tc
WAVESOFT_TC_API_TOKEN=tu_token_de_wavesoft_aqui
