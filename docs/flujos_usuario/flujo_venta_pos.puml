@startuml flujo_venta_pos
!theme plain
skinparam roundcorner 5
skinparam conditionStyle insideDiamond

|Cliente|
start
:Llega al mostrador solicitando\nproductos (celular o accesorio);

|Vendedor|
:Ingresa al módulo de Punto de Venta (POS);

|Sistema POS|
:Verificar estado de Caja Diaria;
if (¿Existe caja abierta para la sucursal?) then (No)
    :Bloquear ventas y mostrar alerta:\n"Debe abrir caja antes de operar";
    |Vendedor|
    :Redirigir a pantalla de Apertura de Caja;
    stop
else (Sí)
    :Habilitar terminal de venta;
endif

|Vendedor|
repeat
    if (¿Qué tipo de producto se va a vender?) then (Dispositivo / Celular)
        :Buscar modelo o escanear/digitar IMEI;
        |Sistema POS|
        :Buscar dispositivo en la sucursal actual;
        if (¿IMEI existe y estado es 'DISPONIBLE'?) then (No)
            :Mostrar error:\n"Equipo no disponible o ya vendido";
        else (Sí)
            :Fijar costo histórico de la unidad física;
            :Agregar dispositivo al carrito de venta;
        endif
    else (Accesorio)
        |Vendedor|
        :Buscar accesorio base (ej: 'Funda iPhone 13');
        |Sistema POS|
        :Listar lotes disponibles con nombre diferenciador\ny precio (ej: 'Silicona Bs 40' vs 'MagSafe Bs 100');
        |Vendedor|
        :Seleccionar lote específico y digitar cantidad;
        |Sistema POS|
        if (¿Stock disponible en el lote seleccionado >= cantidad?) then (No)
            :Mostrar error:\n"Stock insuficiente en este lote";
        else (Sí)
            :Fijar costo unitario histórico del lote;
            :Agregar lote al carrito con subtotal;
        endif
    endif
    |Vendedor|
backward:Continuar agregando ítems;
repeat while (¿Desea agregar más productos al carrito?) is (Sí) not (No)

:Solicitar datos del cliente (Nombre y Celular/WhatsApp);
|Sistema POS|
:Buscar cliente existente o crear nuevo registro;
:Calcular Total de la Venta (Bs);

|Vendedor|
:Preguntar método de pago al cliente;

|Cliente|
if (¿Cómo desea pagar?) then (Efectivo)
    |Cliente|
    :Entrega dinero en efectivo;
    |Vendedor|
    :Digita monto recibido en el POS;
    |Sistema POS|
    :Calcular cambio / vuelto;
    |Vendedor|
    :Entrega el cambio al cliente;
else (Código QR)
    |Sistema POS|
    :Proyectar en pantalla el **QR Oficial Centralizado**\n(Inalterable, configurado por Admin);
    |Cliente|
    :Escanea el QR oficial desde su app bancaria\ny confirma la transferencia;
    |Vendedor|
    :Verifica la recepción del pago en su dispositivo;
    :Digita el número de comprobante o referencia bancaria;
endif

|Sistema POS|
:Iniciar **Transacción Atómica de Venta (ACID)**;
:Insertar registro en tabla 'ventas';
:Insertar líneas en tabla 'detalle_ventas';
if (¿Línea es dispositivo?) then (Sí)
    :Actualizar 'dispositivos':\nset estado_inventario = 'VENDIDO';
endif
if (¿Línea es accesorio?) then (Sí)
    :Actualizar 'lotes_accesorio':\nset stock_actual = stock_actual - cantidad;
endif
:Sumar monto recaudado a la sesión de caja activa;
:Calcular Ganancia Neta:\n(Total Venta - Suma de Costos Históricos);
:Confirmar Transacción (COMMIT);

:Generar Recibo de Venta digital / físico\ncon detalle de IMEIs y plazos de garantía;

|Vendedor|
:Entrega el producto y comprobante (o envía por WhatsApp);

|Cliente|
:Recibe su equipo/accesorio y comprobante;
stop

@enduml
