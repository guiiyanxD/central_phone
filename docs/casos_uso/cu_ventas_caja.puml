@startuml cu_ventas_caja
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 5

actor "Vendedor" as vendedor
actor "Administrador" as admin
actor "Cliente" as cliente <<External>>

rectangle "Módulo: Punto de Venta (POS), Caja Diaria y Clientes" {
    package "Operaciones de Caja Diaria" {
        usecase "CU_POS_01: Abrir Caja Diaria\n(Monto Inicial Efectivo)" as UC_AbrirCaja
        usecase "CU_POS_02: Registrar Gasto Operativo\n(Chips, Tomicha, Pasajes)" as UC_RegistrarGasto
        usecase "CU_POS_03: Gestionar Categorías de Gastos" as UC_GestionCatGastos
        usecase "CU_POS_04: Cerrar Caja Diaria / Arqueo\n(Conteo Físico vs Esperado)" as UC_CerrarCaja
        usecase "CU_POS_05: Consultar Historial de Cajas y Arqueos" as UC_HistorialCajas
    }

    package "Punto de Venta (POS)" {
        usecase "CU_POS_06: Registrar Venta" as UC_RegistrarVenta
        usecase "CU_POS_07: Validar Caja Abierta en Sucursal" as UC_ValidarCaja
        usecase "CU_POS_08: Seleccionar Dispositivo por IMEI" as UC_SeleccionarImei
        usecase "CU_POS_09: Seleccionar Lote Diferenciado de Accesorio" as UC_SeleccionarLoteAcc
        usecase "CU_POS_10: Procesar Cobro con Estrategia de Pago" as UC_ProcesarPago
        usecase "CU_POS_11: Mostrar QR Oficial Centralizado (Pantalla Venta)" as UC_MostrarQr
        usecase "CU_POS_12: Registrar Nro. Referencia Transferencia QR" as UC_RegComprobanteQr
        usecase "CU_POS_13: Asociar / Registrar Datos de Cliente" as UC_AsociarCliente
        usecase "CU_POS_14: Emitir Recibo / Garantía de Venta" as UC_EmitirRecibo
        usecase "CU_POS_15: Consultar Ventas del Día" as UC_VentasDia
        usecase "CU_POS_16: Anular Venta (Restaura Stock e IMEIs)" as UC_AnularVenta
    }

    package "Gestión de Clientes" {
        usecase "CU_POS_17: Gestionar Clientes\n(Búsqueda rápida por WhatsApp / CI)" as UC_GestionClientes
        usecase "CU_POS_18: Consultar Historial de Compras por Cliente" as UC_HistorialCliente
    }
}

' Relaciones de Inclusión y Extensión
UC_RegistrarVenta .> UC_ValidarCaja : <<include>>
UC_RegistrarVenta .> UC_ProcesarPago : <<include>>
UC_RegistrarVenta <.. UC_SeleccionarImei : <<extend>> (si compra teléfono)
UC_RegistrarVenta <.. UC_SeleccionarLoteAcc : <<extend>> (si compra accesorio)
UC_RegistrarVenta <.. UC_AsociarCliente : <<extend>> (opcional)
UC_RegistrarVenta <.. UC_EmitirRecibo : <<extend>>

UC_ProcesarPago <.. UC_MostrarQr : <<extend>> (si método es QR)
UC_ProcesarPago <.. UC_RegComprobanteQr : <<extend>> (si método es QR)

' Interacciones con Actores
cliente --> UC_RegistrarVenta : "compra y paga"

vendedor --> UC_AbrirCaja
vendedor --> UC_RegistrarGasto
vendedor --> UC_CerrarCaja
vendedor --> UC_RegistrarVenta
vendedor --> UC_VentasDia
vendedor --> UC_GestionClientes
vendedor --> UC_HistorialCliente

admin --> UC_GestionCatGastos
admin --> UC_HistorialCajas
admin --> UC_AnularVenta

@enduml
