@startuml cu_administracion_reportes
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 5

actor "Usuario" as user
actor "Administrador" as admin

admin -up-|> user

rectangle "Módulo: Administración, Seguridad, Configuración y Reportes" {
    package "Seguridad y Control de Acceso" {
        usecase "CU_ADM_01: Iniciar Sesión" as UC_Login
        usecase "CU_ADM_02: Cerrar Sesión" as UC_Logout
        usecase "CU_ADM_03: Cambiar Contraseña Propia" as UC_CambiarPass
        usecase "CU_ADM_04: Gestionar Usuarios\n(Crear, Asignar Rol, Asignar Sucursal, Desactivar)" as UC_GestionUsuarios
    }

    package "Configuración Global & Anti-Fraude" {
        usecase "CU_ADM_05: Configurar QR Oficial de Cobro\n(Subir Imagen, Banco, Titular, Nro Cuenta)" as UC_ConfigQr
        usecase "CU_ADM_06: Actualizar Datos de Empresa\n(Nombre Comercial, Logo)" as UC_ConfigEmpresa
        usecase "CU_ADM_07: Gestionar Sucursales\n(Crear, Editar, Activar/Desactivar)" as UC_GestionSucursales
    }

    package "Reportes Financieros y Auditoría" {
        usecase "CU_ADM_08: Consultar Rentabilidad Neta\n(Ganancia real = Venta - Costo Histórico)" as UC_RepRentabilidad
        usecase "CU_ADM_09: Consultar Ventas por Método de Pago\n(Total Efectivo vs Total QR)" as UC_RepMetodoPago
        usecase "CU_ADM_10: Consultar Reporte de Gastos Operativos\n(Por Categoría y Sucursal)" as UC_RepGastos
        usecase "CU_ADM_11: Auditoría y Trazabilidad por IMEI\n(Historial completo de vida del equipo)" as UC_RepTrazabilidadImei
        usecase "CU_ADM_12: Exportar Reportes (Excel / PDF)" as UC_ExportarReportes
    }
}

' Relaciones
UC_RepRentabilidad <.. UC_ExportarReportes : <<extend>>
UC_RepMetodoPago <.. UC_ExportarReportes : <<extend>>
UC_RepGastos <.. UC_ExportarReportes : <<extend>>

' Interacciones con Actores
user --> UC_Login
user --> UC_Logout
user --> UC_CambiarPass

admin --> UC_GestionUsuarios
admin --> UC_ConfigQr
admin --> UC_ConfigEmpresa
admin --> UC_GestionSucursales
admin --> UC_RepRentabilidad
admin --> UC_RepMetodoPago
admin --> UC_RepGastos
admin --> UC_RepTrazabilidadImei

@enduml
